#!/usr/bin/env bash
set -euo pipefail

# This script installs uv version ($1).
# The used script will install uv and uvx binaries into '~/.local/bin'.
#
# $1 : version to install in major.minor.patch format. Default to 0.12.3

VERSION="${1:-0.12.3}"

UV_INSTALL_DIR="$HOME/.local/bin"

# Check current version if any. Exit early if current version matches requested version.
CURRENT_VERSION=$("$UV_INSTALL_DIR"/uv --version 2> /dev/null | awk '{ print $2 }') || true
if [[ "$CURRENT_VERSION" = "$VERSION" ]] ; then
  echo "Info : uv version '$VERSION' already installed in '$UV_INSTALL_DIR'." ; exit 0
fi

# If an old version (!= requested version) exists, update to the requested version.
# Otherwise install the requested version.
if [[ -n "$CURRENT_VERSION" ]] ; then
  echo -n "Info : Updating uv tools to version '$CURRENT_VERSION'..."
  "$UV_INSTALL_DIR"/uv self update "$VERSION"
else
  echo -n "Info : Installing uv tools version '$VERSION'..."
  curl -LsSf https://astral.sh/uv/install.sh | sh -s -- -q
fi
echo "Done"

