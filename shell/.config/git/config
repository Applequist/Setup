[user]
	name = Brieuc Desoutter
	email = brieuc.desoutter@gmail.com
[ui "color"]
  ui = true
[color]
  ui = true
[core]
  autocrlf = input
  safecrlf = true
[merge]
  tool = nvim -d
[alias]
  c = commit
  s = status
  st = status
  ll = log --oneline
  # https://stackoverflow.com/a/11688523/472927
  ss = "!f() { git stash show stash^{/$*} -p; }; f"
  sa = "!f() { git stash apply stash^{/$*}; }; f"
  sl = stash list
[pull]
  ff = only
[push]
  default = simple
[url "git@github.com:"]
  insteadOf = gh:
[diff]
  algorithm = histogram
  indentHeuristic = true
[protocol]
  version = 2
[init]
	defaultBranch = main
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
